<link rel="stylesheet" href="/css/recuperar.css">
<form class="form" action="/request-reset" method="post">
    <section class="recuperar">
        <div id="numero">
            <h1>Recuperar minha senha</h1>
            <p>Vamos enviar um link de redefinição para seu Endereço de email.</p>
            <label>Informe seu email</label>
            <input type="email" name="email" id="recuperarporEmail" placeholder="Informe seu email aqui">
            <button type="submit">Enviar Código</button>
    </section>
</form>