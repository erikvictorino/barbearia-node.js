<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset='utf-8'>
    <meta http-equiv='X-UA-Compatible' content='IE=edge'>
    <title>The barber</title>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <link rel='stylesheet' type='text/css' href='/css/style.css'>
    <script src='/js/main.js' defer></script>
</head>
<body>
    <header>
        <button class="nav-toggle" aria-label="Menu">
            <span></span>
            <span></span>
            <span></span>
        </button>
        <nav>
            <ul>
                {{#if user}}
                    <li><a href="/">Início</a></li>
                  {{#if isAdmin}}
                    {{!-- botão de Agendamentos que só o barbeiro pode ver --}}
                    <li><a href="/agendamentosAll">Agendamentos</a></li>
                    <li><a href="/addServico">Adicionar serviço</a></li>
                    <li><a href="/clienteAll">Clientes</a></li>
                  {{else}}
                    <li><a href="/contato">Contato</a></li>
                    <li><a href="/agendamento">Agendamento</a></li>
                  {{/if}}
                    <li><a href="/logout">Logout</a></li>
                  {{else}}
                    <li><a href="/login">Login</a></li>
                    <li><a href="/cadastro">Cadastro</a></li>
                {{/if}}
            </ul>
        </nav>
    </header>
    {{#if messages.message}}
        <div class="flash-message">{{messages.message}}</div>
    {{/if}}
    <main>
        {{{body}}}
    </main>
    <footer>
        <p>&copy; 2024 The Barber. Todos os direitos reservados.</p>
    </footer>
    <script>
        const toggle = document.querySelector('.nav-toggle');
        const nav = document.querySelector('header nav');
        if (toggle && nav) {
            toggle.addEventListener('click', () => {
                toggle.classList.toggle('open');
                nav.classList.toggle('open');
            });
        }
    </script>
</body>
</html>