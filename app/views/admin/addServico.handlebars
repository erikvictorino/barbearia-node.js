formulario pra criar serviço
<title>Cadastro</title>
<form action="/addServico" method="post" class="form" enctype="multipart/form-data">
    <div class="form-control">
        <label for="imagem">Imagem</label>
        <input type="file" name="image" placeholder="Imagem do serviço">
    </div>
    <div class="form-control">
        <label for="name">Nome:</label>
        <input type="text" name="nome" placeholder="digite o nome do serviço">
    </div>
    <div class="form-control">
        <label for="price">Preço:</label>
        <input type="number" name="preco" placeholder="digite o preço do serviço">
    </div>
    <div class="form-control">
        <label for="duracao">Duração:</label>
        <input type="number" name="duracao" placeholder="digite a duração do serviço">
    </div>
    <input type="submit" value="cadastrar">
</form>